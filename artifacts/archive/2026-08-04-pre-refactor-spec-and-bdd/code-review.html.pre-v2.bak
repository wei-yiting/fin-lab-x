<script>
  // 全頁 syntax highlight + diff renderer（unified / split 雙模式）
  const DIFF_MODE_KEY = 'pr-review-diff-mode';  // 顯示偏好，跨 doc 共用
  const diffRegistry = [];

  function classifyDiffLine(rawLine) {
    if (rawLine.startsWith("@@")) return { cls: "hunk", sign: "", body: rawLine };
    if (rawLine.startsWith("+++") || rawLine.startsWith("---") ||
        rawLine.startsWith("diff --git") || rawLine.startsWith("index "))
      return { cls: "meta", sign: "", body: rawLine };
    if (rawLine.startsWith("+")) return { cls: "add", sign: "+", body: rawLine.slice(1) };
    if (rawLine.startsWith("-")) return { cls: "remove", sign: "-", body: rawLine.slice(1) };
    if (rawLine.startsWith(" ")) return { cls: "context", sign: " ", body: rawLine.slice(1) };
    return { cls: "context", sign: " ", body: rawLine };
  }

  function makeDiffLine(cls, sign, body, lang) {
    const lineEl = document.createElement("div");
    lineEl.className = "diff-line diff-" + cls;
    const signEl = document.createElement("span");
    signEl.className = "diff-sign";
    signEl.textContent = sign;
    const contentEl = document.createElement("span");
    contentEl.className = "diff-content";
    if (cls === "add" || cls === "remove" || cls === "context") {
      try {
        const result = window.hljs.highlight(body, { language: lang, ignoreIllegals: true });
        contentEl.innerHTML = result.value || "&nbsp;";
      } catch (e) {
        contentEl.textContent = body || " ";
      }
    } else {
      contentEl.textContent = body || " ";
    }
    lineEl.appendChild(signEl);
    lineEl.appendChild(contentEl);
    return lineEl;
  }

  function buildUnified(lines, lang, into) {
    for (const raw of lines) {
      const { cls, sign, body } = classifyDiffLine(raw);
      into.appendChild(makeDiffLine(cls, sign, body, lang));
    }
  }

  function buildSplit(lines, lang, into) {
    // GitHub-style pairing：hunk 內連續 remove 與緊接的 add 逐行左右配對
    let lefts = [], rights = [];
    const emitRow = (left, right) => {
      const row = document.createElement("div");
      row.className = "diff-srow";
      row.appendChild(left || makeDiffLine("filler", "", "", lang));
      row.appendChild(right || makeDiffLine("filler", "", "", lang));
      into.appendChild(row);
    };
    const flush = () => {
      const n = Math.max(lefts.length, rights.length);
      for (let i = 0; i < n; i++) emitRow(lefts[i] || null, rights[i] || null);
      lefts = []; rights = [];
    };
    for (const raw of lines) {
      const { cls, sign, body } = classifyDiffLine(raw);
      if (cls === "remove") { lefts.push(makeDiffLine(cls, sign, body, lang)); continue; }
      if (cls === "add") { rights.push(makeDiffLine(cls, sign, body, lang)); continue; }
      flush();
      if (cls === "hunk" || cls === "meta") {
        into.appendChild(makeDiffLine(cls, sign, body, lang));
      } else {
        emitRow(makeDiffLine(cls, sign, body, lang), makeDiffLine(cls, sign, body, lang));
      }
    }
    flush();
  }

  function getDiffMode() {
    return localStorage.getItem(DIFF_MODE_KEY) === "split" ? "split" : "unified";
  }

  function renderDiffBody(entry, mode) {
    entry.body.innerHTML = "";
    entry.body.classList.toggle("split", mode === "split");
    (mode === "split" ? buildSplit : buildUnified)(entry.lines, entry.lang, entry.body);
  }

  function setDiffMode(mode) {
    localStorage.setItem(DIFF_MODE_KEY, mode);
    diffRegistry.forEach((entry) => {
      renderDiffBody(entry, mode);
      entry.buttons.forEach((b) => b.classList.toggle("active", b.dataset.mode === mode));
    });
    // 重繪把 diff 內的 comment <mark> 洗掉了 — 只補回 DOM 上已消失的那些
    if (typeof comments !== "undefined" && typeof restoreComment === "function") {
      comments.forEach((c) => {
        if (c.outdated || !document.querySelector(`mark.annot[data-comment-id="${c.id}"]`)) {
          const ok = restoreComment(c);
          if (ok && c.resolved && typeof updateMarkResolvedState === "function") {
            updateMarkResolvedState(c.id, true);
          }
        }
      });
    }
  }

  function renderDiffs() {
    const mode = getDiffMode();
    document.querySelectorAll("pre[data-diff]").forEach((pre) => {
      const lang = pre.getAttribute("data-lang") || "plaintext";
      let lines = pre.textContent.split("\n");
      if (lines.length && lines[lines.length - 1] === "") lines = lines.slice(0, -1);

      const container = document.createElement("div");
      container.className = "diff-rendered";

      const toolbar = document.createElement("div");
      toolbar.className = "diff-toolbar";
      const toggle = document.createElement("div");
      toggle.className = "diff-mode-toggle";
      const buttons = ["unified", "split"].map((m) => {
        const b = document.createElement("button");
        b.type = "button";
        b.dataset.mode = m;
        b.textContent = m === "unified" ? "Unified" : "Split";
        b.classList.toggle("active", m === mode);
        b.addEventListener("click", () => setDiffMode(m));  // 切一次 = 全頁一起切
        toggle.appendChild(b);
        return b;
      });
      toolbar.appendChild(toggle);
      container.appendChild(toolbar);

      const body = document.createElement("div");
      body.className = "diff-body";
      container.appendChild(body);

      const entry = { body, lines, lang, buttons };
      diffRegistry.push(entry);
      renderDiffBody(entry, mode);

      pre.parentNode.replaceChild(container, pre);
    });
  }

  document.addEventListener("DOMContentLoaded", () => {
    // 1. 普通 code blocks
    document.querySelectorAll("pre code").forEach((block) => {
      window.hljs && window.hljs.highlightElement(block);
    });
    // 2. diff blocks
    renderDiffs();
    // 3. mermaid diagrams (light theme matched to palette)
    if (window.mermaid) {
      window.mermaid.initialize({
        startOnLoad: false,
        theme: 'default',
        themeVariables: {
          primaryColor: '#eef0ff',
          primaryTextColor: '#1c1d21',
          primaryBorderColor: '#5b6cff',
          lineColor: '#7a7e88',
          secondaryColor: '#fcf3df',
          tertiaryColor: '#ecf7ee',
          fontSize: '13px',
          fontFamily: 'system-ui, -apple-system, sans-serif'
        },
        sequence: { useMaxWidth: true, mirrorActors: false, boxMargin: 8 },
        flowchart: { curve: 'basis', htmlLabels: true }
      });
      window.mermaid.run({ querySelector: '.mermaid' })
        .then(() => bindDiagramLightbox())
        .catch(e => console.warn('[code-review] mermaid render failed:', e));
    }
    // 4. annotation system (after DOM + diffs + mermaid are rendered)
    initCommentSystem();
  });

  // ============================================================
  // Diagram lightbox — click any rendered SVG to open as a pan/zoom canvas
  // ============================================================
  let currentMmPanZoom = null;
  const mmBackdrop = document.getElementById('mm-modal-backdrop');
  const mmSvgWrap = document.getElementById('mm-modal-svg-wrap');
  const mmTitle = document.getElementById('mm-modal-title');

  function findDiagramLabel(el) {
    // Walk up siblings/parents looking for an h2/h3/h4 to use as title
    let cur = el;
    while (cur && cur !== document.body) {
      let prev = cur.previousElementSibling;
      while (prev) {
        const tag = prev.tagName;
        if (tag === 'H4' || tag === 'H3' || tag === 'H2') {
          return prev.textContent.replace(/^§\d+\s*/, '').trim();
        }
        prev = prev.previousElementSibling;
      }
      cur = cur.parentElement;
    }
    return 'Diagram';
  }

  function openDiagramLightbox(triggerEl) {
    const origSvg = triggerEl.querySelector('svg');
    if (!origSvg) return;
    const cloned = origSvg.cloneNode(true);
    cloned.removeAttribute('style');
    cloned.removeAttribute('width');
    cloned.removeAttribute('height');
    cloned.setAttribute('preserveAspectRatio', 'xMidYMid meet');
    mmSvgWrap.innerHTML = '';
    mmSvgWrap.appendChild(cloned);
    mmTitle.textContent = findDiagramLabel(triggerEl);
    mmBackdrop.classList.add('show');

    // wait a tick for layout before initializing pan-zoom
    setTimeout(() => {
      try {
        if (window.svgPanZoom) {
          currentMmPanZoom = window.svgPanZoom(cloned, {
            zoomEnabled: true,
            controlIconsEnabled: false,
            fit: true,
            center: true,
            minZoom: 0.3,
            maxZoom: 12,
            zoomScaleSensitivity: 0.4,
            dblClickZoomEnabled: true
          });
        }
      } catch (e) {
        console.warn('[code-review] pan-zoom init failed:', e);
      }
    }, 40);
  }

  function closeDiagramLightbox() {
    mmBackdrop.classList.remove('show');
    if (currentMmPanZoom) {
      try { currentMmPanZoom.destroy(); } catch (e) {}
      currentMmPanZoom = null;
    }
    mmSvgWrap.innerHTML = '';
  }

  function bindDiagramLightbox() {
    // Bind every .mermaid container that has been rendered into SVG
    document.querySelectorAll('.mermaid').forEach(el => {
      if (el.dataset.lbBound) return;
      // Defer binding until Mermaid has actually injected an <svg>
      if (!el.querySelector('svg')) return;
      el.dataset.lbBound = '1';
      el.addEventListener('click', (e) => {
        // Don't trigger when user is selecting text inside the diagram
        const sel = window.getSelection();
        if (sel && sel.toString().trim().length > 0 && el.contains(sel.anchorNode)) return;
        openDiagramLightbox(el);
      });
    });
    // Also bind any standalone SVG (e.g. flow diagrams added by hand) inside .mermaid-panel-equivalent containers
    document.querySelectorAll('.diagram-panel svg, svg.flow').forEach(svg => {
      const wrap = svg.parentElement;
      if (!wrap || wrap.dataset.lbBound) return;
      wrap.dataset.lbBound = '1';
      wrap.style.cursor = 'zoom-in';
      wrap.addEventListener('click', (e) => {
        const sel = window.getSelection();
        if (sel && sel.toString().trim().length > 0 && wrap.contains(sel.anchorNode)) return;
        openDiagramLightbox(wrap);
      });
    });
  }

  if (mmBackdrop) {
    document.getElementById('mm-close').addEventListener('click', closeDiagramLightbox);
    document.getElementById('mm-zoom-in').addEventListener('click', () => currentMmPanZoom?.zoomIn());
    document.getElementById('mm-zoom-out').addEventListener('click', () => currentMmPanZoom?.zoomOut());
    document.getElementById('mm-reset').addEventListener('click', () => {
      if (!currentMmPanZoom) return;
      currentMmPanZoom.resetZoom();
      currentMmPanZoom.center();
      currentMmPanZoom.fit();
    });
    mmBackdrop.addEventListener('click', (e) => {
      if (e.target === mmBackdrop) closeDiagramLightbox();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mmBackdrop.classList.contains('show')) closeDiagramLightbox();
    });
  }
</script>

<script>
// ============================================================
// Comment / Annotation System (localStorage-backed)
// ============================================================
const STORAGE_KEY = 'fin-lab-pr-review-comments-v1';
const DOC_NAME = 'PR Review · feat/multi-provider-streaming-reasoning';
let comments = [];

function uid() {
  return 'c' + Date.now().toString(36) + Math.random().toString(36).slice(2, 6);
}

function escapeHtml(s) {
  return String(s).replace(/[<>&"]/g, c => ({'<':'&lt;','>':'&gt;','&':'&amp;','"':'&quot;'}[c]));
}

function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(t._timer);
  t._timer = setTimeout(() => t.classList.remove('show'), 2800);
}

function getContainingSection(node) {
  // Walk up looking for <section id> first
  let cur = node;
  while (cur && cur !== document.body) {
    if (cur.nodeType === 1 && cur.tagName === 'SECTION' && cur.id) return cur;
    cur = cur.parentNode;
  }
  // Fallback — selection sits outside any <section> but still inside main.content.
  // Treat the entire main as a synthetic section so commenting still works.
  cur = node;
  while (cur && cur !== document.body) {
    if (cur.nodeType === 1 && cur.tagName === 'MAIN') return cur;
    cur = cur.parentNode;
  }
  return null;
}

// ============================================================
// Mark wrapping (selected text → <mark class="annot">)
// ============================================================
function wrapRange(range, commentId) {
  const root = range.commonAncestorContainer.nodeType === 3
    ? range.commonAncestorContainer.parentNode
    : range.commonAncestorContainer;
  const textNodes = [];
  if (range.commonAncestorContainer.nodeType === 3) {
    textNodes.push(range.commonAncestorContainer);
  } else {
    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
      acceptNode(n) {
        return range.intersectsNode(n) ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
      }
    });
    let n;
    while ((n = walker.nextNode())) textNodes.push(n);
  }

  for (const node of textNodes) {
    if (node.parentNode.closest('mark.annot')) continue;
    if (node.parentNode.closest('.comment-panel, .takeaway-panel, .selection-toolbar, .dialog-backdrop, .toast, aside.toc')) continue;

    const start = (node === range.startContainer) ? range.startOffset : 0;
    const end = (node === range.endContainer) ? range.endOffset : node.textContent.length;
    if (start >= end) continue;

    const text = node.textContent;
    const before = text.slice(0, start);
    const wrapped = text.slice(start, end);
    const after = text.slice(end);

    if (!wrapped.trim()) continue;

    const mark = document.createElement('mark');
    mark.className = 'annot';
    mark.dataset.commentId = commentId;
    mark.textContent = wrapped;
    mark.addEventListener('click', e => {
      e.stopPropagation();
      flashComment(commentId);
      scrollToCommentCard(commentId);
    });

    const frag = document.createDocumentFragment();
    if (before) frag.appendChild(document.createTextNode(before));
    frag.appendChild(mark);
    if (after) frag.appendChild(document.createTextNode(after));
    node.parentNode.replaceChild(frag, node);
  }
}

function unwrapMark(commentId) {
  document.querySelectorAll(`mark.annot[data-comment-id="${commentId}"]`).forEach(m => {
    const text = document.createTextNode(m.textContent);
    m.parentNode.replaceChild(text, m);
  });
  document.querySelectorAll('main').forEach(n => n.normalize());
}

// Restore on reload: search selectedText within the section, wrap when found
function restoreComment(c) {
  const section = document.getElementById(c.sectionId);
  if (!section) return false;

  const walker = document.createTreeWalker(section, NodeFilter.SHOW_TEXT, {
    acceptNode(n) {
      if (n.parentNode.closest('.comment-panel, .takeaway-panel, .selection-toolbar, .dialog-backdrop, .toast')) {
        return NodeFilter.FILTER_REJECT;
      }
      return NodeFilter.FILTER_ACCEPT;
    }
  });
  const map = [];
  let combined = '';
  let n;
  while ((n = walker.nextNode())) {
    map.push({ node: n, start: combined.length });
    combined += n.textContent;
  }

  const target = c.selectedText;
  const idx = combined.indexOf(target);
  if (idx < 0) return false;
  const endIdx = idx + target.length;

  let startNode, startOffset, endNode, endOffset;
  for (const item of map) {
    const nodeStart = item.start;
    const nodeEnd = nodeStart + item.node.textContent.length;
    if (startNode === undefined && idx >= nodeStart && idx < nodeEnd) {
      startNode = item.node;
      startOffset = idx - nodeStart;
    }
    if (endNode === undefined && endIdx > nodeStart && endIdx <= nodeEnd) {
      endNode = item.node;
      endOffset = endIdx - nodeStart;
    }
    if (startNode && endNode) break;
  }
  if (!startNode || !endNode) return false;
  try {
    const range = document.createRange();
    range.setStart(startNode, startOffset);
    range.setEnd(endNode, endOffset);
    wrapRange(range, c.id);
    return true;
  } catch (e) { return false; }
}

// ============================================================
// Storage
// ============================================================
function loadComments() {
  const raw = localStorage.getItem(STORAGE_KEY);
  if (raw) {
    try { comments = JSON.parse(raw); } catch (e) { comments = []; }
  }
  let outdated = 0;
  comments.forEach(c => {
    const ok = restoreComment(c);
    if (ok) {
      c.outdated = false;
      if (c.resolved) updateMarkResolvedState(c.id, true);
    } else {
      c.outdated = !c.resolved;
      if (c.outdated) outdated++;
    }
  });
  saveComments();
  renderCommentList();
  if (outdated > 0) showToast(`⧖ ${outdated} comment outdated — 原文字找不到（doc 可能已修改）`);
}

function saveComments() {
  localStorage.setItem(STORAGE_KEY, JSON.stringify(comments));
}

// ============================================================
// Selection toolbar
// ============================================================
const toolbar = document.getElementById('selection-toolbar');
let pendingRange = null;
let pendingText = null;
let pendingSection = null;

function handleSelection() {
  setTimeout(() => {
    try {
      const sel = window.getSelection();
      if (!sel || sel.rangeCount === 0 || sel.isCollapsed) return hideToolbar();
      const text = sel.toString().trim();
      if (!text || text.length < 2) return hideToolbar();
      const range = sel.getRangeAt(0);

      // Skip selection inside the panel/dialog/sidebar/toolbar
      const anchorEl = range.commonAncestorContainer.nodeType === 1
        ? range.commonAncestorContainer
        : range.commonAncestorContainer.parentNode;
      if (anchorEl && anchorEl.closest &&
          anchorEl.closest('.comment-panel, .takeaway-panel, .dialog-backdrop, aside.toc, .selection-toolbar, .sidebar-toggle')) {
        return hideToolbar();
      }

      const section = getContainingSection(range.commonAncestorContainer);
      if (!section) {
        console.warn('[code-review] selection has no <section> or <main> ancestor — ignored');
        return hideToolbar();
      }

      pendingRange = range.cloneRange();
      pendingText = text;
      pendingSection = section;
      showToolbarAt(range);
    } catch (err) {
      console.error('[code-review] handleSelection failed:', err);
      hideToolbar();
    }
  }, 0);
}

function showToolbarAt(range) {
  const rect = range.getBoundingClientRect();
  toolbar.style.display = 'flex';
  const top = window.scrollY + rect.top - toolbar.offsetHeight - 10;
  const left = window.scrollX + rect.left + rect.width / 2 - 75;
  toolbar.style.top = `${Math.max(top, window.scrollY + 8)}px`;
  toolbar.style.left = `${Math.max(left, 8)}px`;
}

function hideToolbar() { toolbar.style.display = 'none'; }

// ============================================================
// Dialog
// ============================================================
function showCommentDialog(selectedText, callback) {
  const dialogBackdrop = document.getElementById('comment-dialog-backdrop');
  const dialogPreview = document.getElementById('dialog-selection-preview');
  const dialogInput = document.getElementById('comment-input');
  const dialogSubmit = document.getElementById('comment-submit');
  const dialogCancel = document.getElementById('comment-cancel');

  dialogPreview.textContent = selectedText.slice(0, 500) + (selectedText.length > 500 ? '…' : '');
  dialogInput.value = '';
  dialogBackdrop.classList.add('show');
  setTimeout(() => dialogInput.focus(), 50);

  // Track where mousedown started so a drag that starts inside the dialog
  // and ends on the backdrop does NOT count as "click outside to dismiss".
  // Without this, selecting text inside the textarea + dragging slightly past
  // its edge closes the dialog and discards the comment.
  let mousedownOnBackdrop = false;

  const cleanup = () => {
    dialogBackdrop.classList.remove('show');
    dialogSubmit.removeEventListener('click', onSubmit);
    dialogCancel.removeEventListener('click', onCancel);
    dialogBackdrop.removeEventListener('mousedown', onBackdropDown);
    dialogBackdrop.removeEventListener('click', onBackdrop);
    document.removeEventListener('keydown', onKey, true);
    dialogInput.removeEventListener('compositionstart', onCompositionStart);
    dialogInput.removeEventListener('compositionend', onCompositionEnd);
  };
  const onSubmit = () => { const v = dialogInput.value.trim(); cleanup(); callback(v); };
  const onCancel = () => { cleanup(); callback(null); };

  // Two-step backdrop dismiss: only close if BOTH mousedown and click happened
  // on the backdrop itself (not bubbled from inside the dialog).
  const onBackdropDown = (e) => {
    mousedownOnBackdrop = (e.target === dialogBackdrop);
  };
  const onBackdrop = (e) => {
    if (e.target === dialogBackdrop && mousedownOnBackdrop) onCancel();
    mousedownOnBackdrop = false;
  };

  // IME composition guard — Chinese / Japanese / Korean input methods fire
  // `Escape` (or keyCode 229) when the user cancels mid-composition or
  // commits the candidate. We must NOT treat that as "close the dialog".
  let isComposing = false;
  const onCompositionStart = () => { isComposing = true; };
  const onCompositionEnd = () => {
    // Defer clearing the flag so the trailing keydown that fires
    // immediately after compositionend is still treated as IME noise.
    setTimeout(() => { isComposing = false; }, 30);
  };

  const onKey = (e) => {
    // Skip everything while IME is composing — applies to keyCode 229 too,
    // which some browsers fire even without composition events.
    if (isComposing || e.isComposing || e.keyCode === 229) return;

    if (e.key === 'Escape') {
      // Only treat as a real dismiss if the textarea is currently focused
      // (or no specific input is focused). Avoids stray Escape from
      // OS-level shortcuts (Spotlight cancel, dictation, emoji picker)
      // accidentally closing the dialog when the dialog doesn't have focus.
      if (document.activeElement === dialogInput || document.activeElement === document.body) {
        e.preventDefault();
        onCancel();
      }
      return;
    }
    if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) {
      e.preventDefault();
      onSubmit();
    }
  };

  dialogSubmit.addEventListener('click', onSubmit);
  dialogCancel.addEventListener('click', onCancel);
  dialogBackdrop.addEventListener('mousedown', onBackdropDown);
  dialogBackdrop.addEventListener('click', onBackdrop);
  // Capture phase so we see the key BEFORE the textarea's own handlers,
  // and we can reliably check isComposing.
  document.addEventListener('keydown', onKey, true);
  dialogInput.addEventListener('compositionstart', onCompositionStart);
  dialogInput.addEventListener('compositionend', onCompositionEnd);
}

// ============================================================
// Render comment list
// ============================================================
function renderCommentList() {
  const list = document.getElementById('comment-list');
  const count = document.getElementById('comment-count');
  const resolvedCount = document.getElementById('resolved-count');
  const outdatedCount = document.getElementById('outdated-count');
  const fabBadge = document.getElementById('fab-badge');
  const help = document.getElementById('comment-help');

  const activeCount = comments.filter(c => !c.resolved && !c.outdated).length;
  const resolvedNum = comments.filter(c => c.resolved).length;
  const outdatedNum = comments.filter(c => c.outdated && !c.resolved).length;

  if (help) help.style.display = comments.length === 0 ? 'block' : 'none';
  count.textContent = activeCount;
  if (resolvedNum > 0) { resolvedCount.style.display = 'inline-flex'; resolvedCount.textContent = `✓ ${resolvedNum}`; }
  else { resolvedCount.style.display = 'none'; }
  if (outdatedNum > 0) { outdatedCount.style.display = 'inline-flex'; outdatedCount.textContent = `⧖ ${outdatedNum}`; }
  else { outdatedCount.style.display = 'none'; }
  if (activeCount > 0) { fabBadge.textContent = activeCount; fabBadge.style.display = 'block'; }
  else { fabBadge.style.display = 'none'; }

  if (comments.length === 0) {
    list.innerHTML = '<div class="empty-state">尚無 comment<br/><br/>選擇文字（含 diff 行）<br/>→ 點 toolbar 的「💬 新增 comment」</div>';
    return;
  }

  list.innerHTML = '';
  const sorted = [...comments].sort((a, b) => {
    const aDim = !!(a.resolved || a.outdated);
    const bDim = !!(b.resolved || b.outdated);
    if (aDim !== bDim) return aDim ? 1 : -1;
    const na = parseInt((a.sectionId || '').replace(/\D/g, '')) || 999;
    const nb = parseInt((b.sectionId || '').replace(/\D/g, '')) || 999;
    if (na !== nb) return na - nb;
    return a.createdAt.localeCompare(b.createdAt);
  });

  sorted.forEach(c => {
    const isResolved = c.resolved === true;
    const isOutdated = c.outdated === true && !isResolved;
    const card = document.createElement('div');
    let cls = 'comment-card';
    if (isResolved) cls += ' resolved';
    if (isOutdated) cls += ' outdated';
    card.className = cls;
    card.dataset.commentId = c.id;

    const toggleLabel = isResolved ? '↩ Undo' : '✓ Resolve';
    let statusPill = '';
    if (isResolved) statusPill = '<span class="status-pill resolved">✓ resolved</span>';
    else if (isOutdated) statusPill = '<span class="status-pill outdated">outdated</span>';

    card.innerHTML = `
      <div class="comment-card-head">
        <div class="comment-section">${escapeHtml(c.sectionLabel || c.sectionId)}</div>
        ${statusPill}
      </div>
      <div class="comment-quote">${escapeHtml(c.selectedText.length > 140 ? c.selectedText.slice(0, 140) + '…' : c.selectedText)}</div>
      <div class="comment-body">${escapeHtml(c.comment)}</div>
      <div class="comment-meta">
        <span>${new Date(c.createdAt).toLocaleString('zh-TW', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' })}</span>
        <span style="display:flex; gap:6px;">
          <button class="btn-toggle" data-id="${c.id}">${toggleLabel}</button>
          <button class="btn-delete" data-id="${c.id}" title="刪除 comment" aria-label="刪除">×</button>
        </span>
      </div>
    `;
    card.addEventListener('click', e => {
      if (e.target.classList.contains('btn-delete')) return;
      if (e.target.classList.contains('btn-toggle')) return;
      if (isOutdated) { showToast('⧖ 文字已不在 doc 中'); return; }
      scrollToMark(c.id);
    });
    card.querySelector('.btn-toggle').addEventListener('click', e => {
      e.stopPropagation();
      toggleResolved(c.id);
    });
    card.querySelector('.btn-delete').addEventListener('click', e => {
      e.stopPropagation();
      if (!confirm('刪除這個 comment？')) return;
      deleteComment(c.id);
    });
    list.appendChild(card);
  });
}

function toggleResolved(id) {
  const c = comments.find(x => x.id === id);
  if (!c) return;
  c.resolved = !c.resolved;
  if (c.resolved) c.resolvedAt = new Date().toISOString();
  else {
    delete c.resolvedAt;
    const hasMark = !!document.querySelector(`mark.annot[data-comment-id="${c.id}"]`);
    c.outdated = !hasMark;
  }
  saveComments();
  updateMarkResolvedState(id, c.resolved);
  renderCommentList();
  showToast(c.resolved ? '✓ 標為 resolved' : '↩ 恢復為待處理');
}

function updateMarkResolvedState(commentId, isResolved) {
  document.querySelectorAll(`mark.annot[data-comment-id="${commentId}"]`).forEach(m => {
    m.classList.toggle('resolved', isResolved);
  });
}

function scrollToMark(commentId) {
  const mark = document.querySelector(`mark.annot[data-comment-id="${commentId}"]`);
  if (!mark) { showToast('找不到對應的 highlight（可能 orphan）'); return; }
  mark.scrollIntoView({ behavior: 'smooth', block: 'center' });
  flashMark(commentId);
}

function scrollToCommentCard(commentId) {
  const card = document.querySelector(`.comment-card[data-comment-id="${commentId}"]`);
  if (!card) return;
  document.getElementById('comment-panel').classList.add('open');
  card.scrollIntoView({ behavior: 'smooth', block: 'center' });
  card.style.transition = 'background 0.3s';
  card.style.background = 'var(--accent-soft)';
  setTimeout(() => { card.style.background = ''; }, 800);
}

function flashMark(commentId) {
  document.querySelectorAll(`mark.annot[data-comment-id="${commentId}"]`).forEach(m => {
    m.classList.remove('pulse');
    void m.offsetWidth;
    m.classList.add('pulse');
    setTimeout(() => m.classList.remove('pulse'), 1700);
  });
}

function flashComment(commentId) { flashMark(commentId); }

function deleteComment(id) {
  comments = comments.filter(c => c.id !== id);
  saveComments();
  unwrapMark(id);
  renderCommentList();
  showToast('已刪除');
}

// ============================================================
// Export
// ============================================================
function getActiveSorted() {
  return comments.filter(c => !c.resolved && !c.outdated).sort((a, b) => {
    const na = parseInt((a.sectionId || '').replace(/\D/g, '')) || 999;
    const nb = parseInt((b.sectionId || '').replace(/\D/g, '')) || 999;
    if (na !== nb) return na - nb;
    return a.createdAt.localeCompare(b.createdAt);
  });
}

function buildJsonPayload(active) {
  return {
    version: 1,
    doc: DOC_NAME,
    exported_at: new Date().toISOString(),
    comment_count: active.length,
    resolved_excluded: comments.filter(c => c.resolved).length,
    outdated_excluded: comments.filter(c => c.outdated && !c.resolved).length,
    comments: active
  };
}

function buildPromptMarkdown(active) {
  const resolvedNum = comments.filter(c => c.resolved).length;
  const outdatedNum = comments.filter(c => c.outdated && !c.resolved).length;
  let md = `# Comments on ${DOC_NAME}\n\n`;
  md += `Exported: ${new Date().toISOString()}\n`;
  md += `Total: ${active.length} comment${active.length !== 1 ? 's' : ''} (active only)\n`;
  if (resolvedNum > 0) md += `Resolved (excluded): ${resolvedNum}\n`;
  if (outdatedNum > 0) md += `Outdated / orphaned (excluded): ${outdatedNum}\n`;
  md += `\n---\n\n`;
  active.forEach((c, i) => {
    md += `## ${i + 1}. ${c.sectionLabel || c.sectionId}\n\n`;
    md += `**Selected text** (from ${c.sectionId}):\n\n> ${c.selectedText.split('\n').join('\n> ')}\n\n`;
    md += `**My comment**:\n${c.comment}\n\n`;
    md += `---\n\n`;
  });
  return md;
}

function downloadBlob(content, mime, filename) {
  const blob = new Blob([content], { type: mime });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = filename;
  document.body.appendChild(a);
  a.click();
  a.remove();
  URL.revokeObjectURL(url);
}

// ============================================================
// Init — wire all listeners
// ============================================================
function initCommentSystem() {
  // selection
  document.addEventListener('mouseup', e => {
    if (e.target.closest('.selection-toolbar, .comment-panel, .takeaway-panel, .dialog-backdrop')) return;
    handleSelection();
  });
  document.addEventListener('keyup', e => { if (e.shiftKey) handleSelection(); });
  document.addEventListener('mousedown', e => {
    if (!e.target.closest('.selection-toolbar')) hideToolbar();
  });

  // add comment button
  document.getElementById('btn-add-comment').addEventListener('click', () => {
    if (!pendingRange || !pendingText || !pendingSection) return;
    showCommentDialog(pendingText, (commentText) => {
      if (!commentText) return;
      // Section label: §0 maps to "Overview" (banner); s1-s7 use the h2 title;
      // fallback `<main>` becomes "Other".
      let sectionLabel;
      const id = pendingSection.id;
      const sectionNumMatch = id.match(/^s(\d+)$/);
      if (id === 'main') {
        sectionLabel = 'Other';
      } else if (id === 's0') {
        sectionLabel = '§0 Overview';
      } else if (sectionNumMatch) {
        const h2 = pendingSection.querySelector('h2');
        const sectionTitle = h2 ? h2.textContent.replace(/^§\d+\s*/, '').trim() : '';
        sectionLabel = `§${sectionNumMatch[1]} ${sectionTitle}`.trim();
      } else {
        sectionLabel = id;
      }
      const c = {
        id: uid(),
        sectionId: pendingSection.id,
        sectionLabel,
        selectedText: pendingText,
        comment: commentText,
        resolved: false,
        createdAt: new Date().toISOString()
      };
      comments.push(c);
      saveComments();
      try { wrapRange(pendingRange, c.id); }
      catch (e) { restoreComment(c); }
      window.getSelection().removeAllRanges();
      hideToolbar();
      pendingRange = null; pendingText = null; pendingSection = null;
      renderCommentList();
      showToast('Comment 已新增');
    });
  });

  // copy JSON
  document.getElementById('btn-copy-json').addEventListener('click', () => {
    const active = getActiveSorted();
    if (active.length === 0) {
      showToast(comments.length > 0 ? '全部 resolved / outdated' : '沒有 comment');
      return;
    }
    const json = JSON.stringify(buildJsonPayload(active), null, 2);
    navigator.clipboard?.writeText(json).then(() => {
      const note = comments.length - active.length > 0 ? `（排除 ${comments.length - active.length} 個）` : '';
      showToast(`✓ Copied ${active.length} comment 到剪貼簿 ${note}`);
    }).catch(() => showToast('複製失敗，瀏覽器拒絕剪貼簿存取'));
  });

  // export dropdown
  const exportMenuBtn = document.getElementById('btn-export-menu');
  const exportDropdown = document.getElementById('export-dropdown');
  exportMenuBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    exportDropdown.classList.toggle('show');
  });
  document.addEventListener('click', (e) => {
    if (!e.target.closest('.export-menu-wrap')) exportDropdown.classList.remove('show');
  });
  exportDropdown.querySelectorAll('.export-option').forEach(opt => {
    opt.addEventListener('click', () => {
      const fmt = opt.dataset.format;
      exportDropdown.classList.remove('show');
      const active = getActiveSorted();
      if (active.length === 0) {
        showToast(comments.length > 0 ? '全部 resolved / outdated' : '沒有 comment');
        return;
      }
      const date = new Date().toISOString().slice(0, 10);
      if (fmt === 'json') {
        const json = JSON.stringify(buildJsonPayload(active), null, 2);
        downloadBlob(json, 'application/json', `code-review-comments-${date}.json`);
        showToast(`↓ Downloaded code-review-comments-${date}.json`);
      } else if (fmt === 'prompt') {
        const md = buildPromptMarkdown(active);
        downloadBlob(md, 'text/markdown', `code-review-comments-prompt-${date}.md`);
        showToast(`↓ Downloaded code-review-comments-prompt-${date}.md`);
      }
    });
  });

  // resolve all / clear all
  document.getElementById('btn-resolve-all').addEventListener('click', () => {
    const active = comments.filter(c => !c.resolved && !c.outdated);
    if (active.length === 0) { showToast('沒有 active comment'); return; }
    if (!confirm(`把全部 ${active.length} 個 active comment 標為 resolved？`)) return;
    const now = new Date().toISOString();
    active.forEach(c => {
      c.resolved = true; c.resolvedAt = now;
      updateMarkResolvedState(c.id, true);
    });
    saveComments();
    renderCommentList();
    showToast(`✓ 已標 ${active.length} 個為 resolved`);
  });

  document.getElementById('btn-clear-all').addEventListener('click', () => {
    if (comments.length === 0) return;
    if (!confirm(`刪除全部 ${comments.length} 個 comment？`)) return;
    comments.forEach(c => unwrapMark(c.id));
    comments = [];
    saveComments();
    renderCommentList();
    showToast('已清空');
  });

  // mobile FAB
  document.getElementById('comment-fab').addEventListener('click', () => {
    document.getElementById('comment-panel').classList.toggle('open');
  });

  // sidebar toggle (collapsible TOC — hover preview / click pin)
  initSidebarToggle();

  // draggable resize for the comment panel
  initCommentResize();

  // left takeaway panel — scroll sync, click-to-jump, hide/reopen, resize
  initTakeawayPanel();

  // smooth-scroll for TOC anchors (built-in via html { scroll-behavior: smooth })
  // — also handled implicitly by `href="#anchor"`.

  // finally, hydrate from localStorage
  loadComments();
  console.log('[code-review] comment system ready · localStorage key:', STORAGE_KEY);
}

// ============================================================
// Takeaway panel (left) — scroll-synced per-file rationale cards
// ============================================================
function initTakeawayPanel() {
  const panel = document.getElementById('takeaway-panel');
  if (!panel) return;
  const HIDDEN_KEY = 'fin-lab-pr-review-takeaway-hidden-v1';
  const WIDTH_KEY = 'fin-lab-pr-review-takeaway-width-v1';
  const MIN = 280;
  const DEFAULT = 380;
  const root = document.documentElement;
  const indicator = document.getElementById('takeaway-active-indicator');
  const cards = Array.from(panel.querySelectorAll('.tw-card'));

  // ---- hide / reopen ----
  const setHidden = (hidden) => {
    document.body.classList.toggle('takeaway-hidden', hidden);
    localStorage.setItem(HIDDEN_KEY, hidden ? '1' : '0');
  };
  if (localStorage.getItem(HIDDEN_KEY) === '1') setHidden(true);
  document.getElementById('takeaway-close')?.addEventListener('click', () => setHidden(true));
  document.getElementById('takeaway-reopen')?.addEventListener('click', () => setHidden(false));

  // ---- resize (right-edge handle; panel anchored left → width grows rightward) ----
  const handle = document.getElementById('takeaway-resize');
  const maxWidth = () => Math.max(MIN, Math.round(window.innerWidth * 0.5));
  const clamp = (w) => Math.min(maxWidth(), Math.max(MIN, w));
  const apply = (w) => root.style.setProperty('--takeaway-w', clamp(w) + 'px');
  const saved = parseInt(localStorage.getItem(WIDTH_KEY) || '', 10);
  if (!Number.isNaN(saved)) apply(saved);

  let dragging = false;
  const onMove = (e) => {
    if (!dragging) return;
    const x = e.touches ? e.touches[0].clientX : e.clientX;
    // width = cursor distance from the panel's left edge (0 or 240 when TOC pinned)
    apply(x - panel.getBoundingClientRect().left);
    e.preventDefault();
  };
  const onUp = () => {
    if (!dragging) return;
    dragging = false;
    document.body.classList.remove('takeaway-resizing');
    const px = parseInt(getComputedStyle(root).getPropertyValue('--takeaway-w'), 10);
    if (!Number.isNaN(px)) localStorage.setItem(WIDTH_KEY, String(px));
    window.removeEventListener('mousemove', onMove);
    window.removeEventListener('mouseup', onUp);
    window.removeEventListener('touchmove', onMove);
    window.removeEventListener('touchend', onUp);
  };
  handle?.addEventListener('mousedown', (e) => {
    dragging = true;
    document.body.classList.add('takeaway-resizing');
    window.addEventListener('mousemove', onMove);
    window.addEventListener('mouseup', onUp);
    window.addEventListener('touchmove', onMove, { passive: false });
    window.addEventListener('touchend', onUp);
    e.preventDefault();
  });
  handle?.addEventListener('dblclick', () => {
    apply(DEFAULT);
    localStorage.setItem(WIDTH_KEY, String(DEFAULT));
  });
  window.addEventListener('resize', () => {
    const cur = parseInt(getComputedStyle(root).getPropertyValue('--takeaway-w'), 10);
    if (!Number.isNaN(cur)) apply(cur);
  });

  // ---- scroll sync: highlight the card whose walkthrough anchor is in view ----
  const anchors = cards
    .map(c => ({ card: c, el: document.getElementById(c.dataset.anchor) }))
    .filter(a => a.el);

  let activeCard = null;
  const setActive = (entry) => {
    if (!entry || entry.card === activeCard) return;
    activeCard = entry.card;
    cards.forEach(c => c.classList.remove('active'));
    entry.card.classList.add('active');
    if (indicator) {
      const num = entry.card.querySelector('.tw-num');
      if (num) indicator.textContent = num.textContent;
    }
    // center the active card inside the panel (no page scroll)
    const panelRect = panel.getBoundingClientRect();
    const cardRect = entry.card.getBoundingClientRect();
    const offset = cardRect.top - panelRect.top - panelRect.height / 2 + cardRect.height / 2;
    panel.scrollTo({ top: Math.max(0, panel.scrollTop + offset), behavior: 'smooth' });
  };

  let ticking = false;
  const syncFromScroll = () => {
    ticking = false;
    if (anchors.length === 0) return;
    // active anchor = last one whose heading sits above the 35%-viewport line
    const line = window.innerHeight * 0.35;
    let current = null;
    for (const a of anchors) {
      if (a.el.getBoundingClientRect().top <= line) current = a;
    }
    setActive(current || anchors[0]);
  };
  window.addEventListener('scroll', () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(syncFromScroll);
  }, { passive: true });
  syncFromScroll();

  // ---- click a card → jump to that file's walkthrough ----
  cards.forEach(c => {
    c.addEventListener('click', (e) => {
      // skip when user is selecting text or hitting an interactive child
      const sel = window.getSelection();
      if (sel && !sel.isCollapsed && sel.toString().trim().length > 0) return;
      if (e.target.closest('button, .takeaway-resize, mark.annot, a')) return;
      const target = document.getElementById(c.dataset.anchor);
      if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
}

// ============================================================
// Comment panel — draggable width resize (persists in localStorage)
// ============================================================
function initCommentResize() {
  const handle = document.getElementById('comment-resize');
  if (!handle) return;
  const WIDTH_KEY = 'fin-lab-pr-review-comment-width-v1';
  const MIN = 260;
  const DEFAULT = 340;
  const root = document.documentElement;

  const maxWidth = () => Math.max(MIN, Math.round(window.innerWidth * 0.6));
  const clamp = (w) => Math.min(maxWidth(), Math.max(MIN, w));
  const apply = (w) => root.style.setProperty('--comment-w', clamp(w) + 'px');

  // hydrate saved width
  const saved = parseInt(localStorage.getItem(WIDTH_KEY) || '', 10);
  if (!Number.isNaN(saved)) apply(saved);

  let dragging = false;
  const onMove = (e) => {
    if (!dragging) return;
    const x = e.touches ? e.touches[0].clientX : e.clientX;
    // panel is anchored to the viewport right edge → width grows leftward
    apply(window.innerWidth - x);
    e.preventDefault();
  };
  const onUp = () => {
    if (!dragging) return;
    dragging = false;
    document.body.classList.remove('comment-resizing');
    const w = getComputedStyle(root).getPropertyValue('--comment-w').trim();
    const px = parseInt(w, 10);
    if (!Number.isNaN(px)) localStorage.setItem(WIDTH_KEY, String(px));
    window.removeEventListener('mousemove', onMove);
    window.removeEventListener('mouseup', onUp);
    window.removeEventListener('touchmove', onMove);
    window.removeEventListener('touchend', onUp);
  };
  const onDown = (e) => {
    dragging = true;
    document.body.classList.add('comment-resizing');
    window.addEventListener('mousemove', onMove);
    window.addEventListener('mouseup', onUp);
    window.addEventListener('touchmove', onMove, { passive: false });
    window.addEventListener('touchend', onUp);
    e.preventDefault();
  };
  handle.addEventListener('mousedown', onDown);
  handle.addEventListener('touchstart', onDown, { passive: false });

  // double-click to reset
  handle.addEventListener('dblclick', () => {
    apply(DEFAULT);
    localStorage.setItem(WIDTH_KEY, String(DEFAULT));
  });

  // keep within bounds on viewport resize
  window.addEventListener('resize', () => {
    const cur = parseInt(getComputedStyle(root).getPropertyValue('--comment-w'), 10);
    if (!Number.isNaN(cur)) apply(cur);
  });
}

// ============================================================
// Sidebar toggle — hover overlay / click pin (from design.html)
// ============================================================
function initSidebarToggle() {
  const sidebarToggle = document.getElementById('sidebar-toggle');
  const sidebarEl = document.getElementById('toc-sidebar');
  if (!sidebarToggle || !sidebarEl) return;

  let sidebarPinned = false;
  let sidebarHoverTimer = null;

  function setSidebarPinned(pinned) {
    sidebarPinned = pinned;
    document.body.classList.toggle('sidebar-pinned', pinned);
    if (pinned) {
      sidebarEl.classList.add('show', 'pinned-mode');
      sidebarEl.classList.remove('hover-mode');
    } else {
      sidebarEl.classList.remove('show', 'pinned-mode', 'hover-mode');
    }
  }

  function showSidebarHover() {
    if (sidebarPinned) return;
    clearTimeout(sidebarHoverTimer);
    sidebarEl.classList.add('show', 'hover-mode');
  }

  function hideSidebarHover() {
    if (sidebarPinned) return;
    clearTimeout(sidebarHoverTimer);
    sidebarHoverTimer = setTimeout(() => {
      if (!sidebarPinned) {
        sidebarEl.classList.remove('show', 'hover-mode');
      }
    }, 180);
  }

  sidebarToggle.addEventListener('click', () => setSidebarPinned(!sidebarPinned));
  sidebarToggle.addEventListener('mouseenter', showSidebarHover);
  sidebarToggle.addEventListener('mouseleave', hideSidebarHover);
  sidebarEl.addEventListener('mouseenter', () => {
    if (sidebarPinned) return;
    clearTimeout(sidebarHoverTimer);
  });
  sidebarEl.addEventListener('mouseleave', hideSidebarHover);
  // Click TOC link while in hover mode → close sidebar after navigation
  sidebarEl.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      if (!sidebarPinned) {
        sidebarEl.classList.remove('show', 'hover-mode');
      }
    });
  });
}
</script>

</body>
</html>
